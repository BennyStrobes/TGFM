// Analysis-specific parameters.
// Load via: nextflow run workflow/main.nf -profile sanger -c conf/analysis.config
//
// NOTE: ${params.xxx} references within a params {} block do NOT work — Nextflow
// resolves `params` to the top-level (empty) map at parse time, producing "[:]".
// Use Groovy variables defined outside the block instead.

def _bh = "/lustre/scratch127/humgen/projects_v2/sc-eqtl-ibd/analysis/bradley_analysis/IBDverse/TGFM"
def _jl = "/lustre/scratch127/humgen/projects_v2/sc-eqtl-ibd/analysis/jingling_analysis"
def _out = "${_bh}/results"

// Set to true to use major cell population (MCP) eQTL summary statistics
def _mcp = true

// External input roots
def _eqtl_geno = "/lustre/scratch127/humgen/projects_v2/sc-eqtl-ibd/core_analysis_output/IBDverse_multi-tissue_eQTL_project/IBDverse_genotypes/2024_07_11-genotype_plate12345/plink"
def _eqtl_sumstat = _mcp ? "${_jl}/IBDverse_data/reformatted_eqtl_sumstat_mcp" : "${_jl}/IBDverse_data/reformatted_eqtl_sumstat"
def _gwas_sumstat = "${_jl}/IBDverse_data/DeLange_sumstat"

// Jingling's script locations (read-only at runtime)
def _jl_scripts_window  = "${_jl}/prepare_input_data/scripts/generate_window_file"
def _jl_scripts_isect   = "${_jl}/prepare_input_data/scripts/intersect_GWAS_sumstat"
def _jl_scripts_filter  = "${_jl}/prepare_input_data/scripts/filter_GWAS_genotype"
def _jl_tgfm_code       = "${_jl}/output_data/TGFM_scripts"

params {

    // ── Analysis mode ─────────────────────────────────────────────────────────
    // Set _mcp = true above to switch to MCP eQTL sumstats
    mcp = _mcp

    // ── Chromosomes, traits, chunks ───────────────────────────────────────────
    chromosomes = "1-22"   // Can be overridden: e.g. "1,5,10" or "1-22"
    traits      = "CD,UC,IBD"
    n_chunks    = 50

    // ── External inputs (read-only, from outside this directory) ─────────────
    // Raw humancore exome plink prefix (pre-filtering)
    geno_raw_prefix     = "${_jl}/human_exome_core_genotype/humancoreexome_allchr_subset_included_in_ibd_analysis"
    // eQTL plink (per-chromosome imputed genotype for eQTL fine-mapping)
    eqtl_plink_dir      = _eqtl_geno
    // eQTL summary statistics base directory (contains dMean__*_ct_all subfolders)
    eqtl_sumstat_dir    = _eqtl_sumstat
    // GWAS summary statistics directory (input, pre-filtering)
    gwas_sumstat_dir    = _gwas_sumstat
    // Pre-computed file listing SNPs common to all 3 traits
    three_trait_snps    = "${_jl}/prepare_input_data/scripts/intersect_GWAS_sumstat/common_snps.txt"

    // ── Jingling script references ────────────────────────────────────────────
    generate_windows_script       = "${_jl_scripts_window}/generate_windows.py"
    make_nan_indices_script       = "${_jl}/prepare_input_data/scripts/make_nan_indices.py"
    generate_final_windows_script = "${_jl}/prepare_input_data/scripts/generate_final_windows_file.py"
    // Local copy — no hardcoded paths; uses INPUT_PLINK_PREFIX / OUTPUT_PLINK_PREFIX env vars
    correct_flip_script           = "${_bh}/scripts/correct_flip.sh"
    // Optional: set to the original Jingling correct_flip.sh to delegate the actual logic
    correct_flip_delegate         = "${_jl_scripts_filter}/correct_flip.sh"
    // If pre-computed corrected-flip files exist at this prefix, symlink them into
    // results/genotype/ and skip CORRECT_FLIP entirely.  Leave empty to always run the script.
    geno_corrected_flip_source    = "/lustre/scratch127/humgen/projects_v2/sc-eqtl-ibd/analysis/jingling_analysis/human_core_exome_genotype/humancoreexome_filtered_plink_corrected_flip"

    // ── Our generated inputs (updated from Jingling's pre-computed versions) ──
    plink_prefix        = "${_out}/genotype/humancoreexome_filtered_plink_corrected_flip"
    window_dir          = "${_out}/window_files"
    nan_indices_file    = "${_out}/ld_prep/nan_indices/total_nan_indices.txt"
    tgfm_input_dir      = "${_out}/tgfm_input_chunks"
    tissue_summary_file = "${_out}/tissue_summary_file.txt"
    tissue_prior_dir    = "${_out}/tissue_prior"

    // ── Output directories (all under results/) ───────────────────────────────
    geno_output_dir          = "${_out}/genotype"
    sumstats_output_dir      = "${_out}/sumstats"
    window_output_dir        = "${_out}/window_files"
    eqtl_fm_dir              = "${_out}/eqtl_fine_mapping"
    tgfm_input_raw_dir       = "${_out}/tgfm_input"
    tgfm_input_chunks_dir    = "${_out}/tgfm_input_chunks"
    tgfm_no_sample_dir       = "${_out}/tgfm_without_sampling"
    tissue_prior_output_dir  = "${_out}/tissue_prior"
    tgfm_final_dir           = "${_out}/tgfm_final"
    gwas_summary_file        = "${_out}/gwas_summary_file.txt"

    // ── LD matrix output directories ─────────────────────────────────────────
    plink_perwindow_dir     = "${_out}/ld_prep/plink_perwindow"
    ld_matrix_dir           = "${_out}/ld_prep/LD_matrix_perwindow"
    npy_output_dir          = "${_out}/ld_prep/ld_npy_perwindow"
    variant_info_output_dir = "${_out}/ld_prep/variant_info_perwindow"
    nan_indices_dir         = "${_out}/ld_prep/nan_indices"

    // ── Bradley's directories ─────────────────────────────────────────────────
    bh_dir     = _bh
    output_dir = _out

    // ── Tool paths ────────────────────────────────────────────────────────────
    plink2_bin          = "${_jl}/prepare_input_data/scripts/generate_window_file/plink2"
    generate_npy_script = "${_bh}/scripts/generate_npy_variant_info.py"

    // ── Our pipeline scripts (updated versions) ───────────────────────────────
    prepare_input_script        = "${_bh}/scripts/prepare_input_data_for_tgfm_updated.py"
    generate_window_chunk_script = "${_bh}/scripts/generate_window_per_chunk.py"
    make_gwas_summary_script    = "${_bh}/scripts/make_gwas_summary_file.py"
    run_tgfm_updated_script     = "${_bh}/scripts/run_tgfm_updated.py"
    run_tgfm_no_sample_script   = "${_bh}/scripts/run_tgfm_without_sampling.py"
    tissue_prior_script         = "${_bh}/scripts/run_tgfm_tissue_specific_prior.py"
    susie_eqtl_script           = "${_bh}/scripts/susie_eqtl_fine_mapping_for_tgfm.py"
    // tgfm_nan_update_v2.py must live alongside run_tgfm_updated.py (same scripts/ dir)

    // ── Singularity containers ────────────────────────────────────────────────
    container_python = "/software/hgi/softpack/installs/users/jh59/test-tgfm/1-scripts/singularity.sif"
    container_tgfm   = "/software/hgi/softpack/installs/users/jh59/test-tgfm/2-scripts/singularity.sif"

    // ── Skip flags ────────────────────────────────────────────────────────────
    skip_intersect     = false   // skip INTERSECT_GWAS_GENO + CORRECT_FLIP
    skip_ld_generation = false   // skip GENERATE_WINDOWS through GENERATE_FINAL_WINDOWS
    skip_eqtl_fm       = false   // skip SUSIE_EQTL_FM
}
