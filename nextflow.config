// Nextflow infrastructure configuration for TGFM pipeline.
// Analysis parameters are in conf/analysis.config.

params {
    max_memory = '700.GB'
    max_cpus   = 32
    max_time   = '720.h'
    tracedir   = "${launchDir}/results/pipeline_info"
}

profiles {
    sanger {
        process {
            executor       = 'lsf'
            queue          = 'normal'
            clusterOptions = '-G team152 -a "memlimit=True"'
            cache          = 'lenient'
        }
        singularity {
            enabled    = true
            autoMounts = true
            runOptions = '--bind /lustre/scratch127'
        }
        executor {
            name           = 'lsf'
            queueSize      = 500
            pollInterval   = '30 sec'
            submitRateLimit = '50/1min'
        }
    }
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_report_${trace_timestamp}.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/pipeline_dag_${trace_timestamp}.svg"
}

manifest {
    name            = 'TGFM-IBDverse'
    author          = 'Bradley Harris'
    description     = 'Tissue-specific fine-mapping with TGFM for IBD traits (CD, UC, IBD)'
    mainScript      = 'workflow/main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}

process {
    executor = 'lsf'
    queue    = 'normal'
    clusterOptions = '-a "memlimit=True" -G team152'

    errorStrategy = { task.exitStatus in [130, 143, 137, 104, 134, 139, 140] ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    withLabel: 'mem_100GB' {
        memory = '100 GB'
        time   = { task.exitStatus == 140 ? '48 h' : '12 h' }
        queue  = { task.exitStatus == 140 ? 'long' : 'normal' }
    }
    withLabel: 'mem_100GB_long' {
        memory = '100 GB'
        time   = '48 h'
        queue  = 'long'
    }
    withLabel: 'mem_30GB_long' {
        memory = '30 GB'
        time   = '48 h'
        queue  = 'long'
    }
    withLabel: 'mem_low' {
        memory = '8 GB'
        time   = { task.exitStatus == 140 ? '12 h' : '2 h' }
        queue  = { task.exitStatus == 140 ? 'long' : 'normal' }
    }
}
